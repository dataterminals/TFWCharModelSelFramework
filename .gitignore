# Extracted game assets are copyright-derived — never commit them.
build/
extracted/
*.uasset
*.uexp
*.ubulk
*.usmap

# The game's pak AES key is the game's own decryption key — supply it locally, never commit it.
fw_aes.txt
aes.txt
aes.key
retoc/

# Built mod artifacts (attach to releases instead)
dist/**/*.pak
dist/**/*.utoc
dist/**/*.ucas

# .NET build output
bin/
obj/

__pycache__/
*.pyc

# published tool output (rebuild with: dotnet publish tools/cmsf -c Release -o dist/cmsf-tool)
dist/cmsf-tool/
# v0.2 author tool (dotnet publish tools/cmsf-author -c Release -o dist/cmsf-author)
dist/cmsf-author/
# dist releases: the distributable mod zips (CMSF-v*.zip, ~180K — our own pak + Lua) are
# TRACKED so a second dev machine gets them on `git pull`. The ~36M author-tool bundle
# (CMSF-author-*.zip = cmsf-author.exe + retoc.exe) stays local — rebuild it with:
#   dotnet publish tools/cmsf-author -c Release   (then tools/package-release.ps1)
dist/release/*
!dist/release/CMSF-v*.zip
